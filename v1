# Function to scrape gold-related news headlines
def get_gold_news():
    url = "https://www.reuters.com/markets/commodities/"
    headers = {'User-Agent': 'Mozilla/5.0'}
    response = requests.get(url, headers=headers)
    
    if response.status_code == 200:
        soup = BeautifulSoup(response.text, 'html.parser')
        articles = soup.find_all('h3', class_='story-title')  # Adjust class based on actual HTML
        
        news_data = []
        for article in articles[:10]:  # Get top 10 news
            headline = article.text.strip()
            sentiment = TextBlob(headline).sentiment.polarity
            news_data.append((headline, sentiment))
        
        return news_data
    else:
        return []

# Function to fetch real-time gold price
def get_gold_price():
    gold_api_url = "https://api.metals.live/v1/spot"
    response = requests.get(gold_api_url)
    
    if response.status_code == 200:
        gold_data = response.json()
        return gold_data['gold']['price']
    else:
        return None

# Function to fetch historical gold prices
def get_historical_gold_prices():
    gold_hist_url = "https://api.metals.live/v1/history/gold"
    response = requests.get(gold_hist_url)
    
    if response.status_code == 200:
        return response.json()
    else:
        return []

# Function to compute technical indicators
def compute_technical_indicators(prices):
    close_prices = np.array([data['price'] for data in prices], dtype=float)
    
    rsi = talib.RSI(close_prices, timeperiod=14)
    macd, macd_signal, _ = talib.MACD(close_prices, fastperiod=12, slowperiod=26, signalperiod=9)
    sma = talib.SMA(close_prices, timeperiod=50)
    
    return rsi, macd, macd_signal, sma

# Function to analyze sentiment and predict trend
def analyze_trend(news_data):
    sentiment_scores = [item[1] for item in news_data]
    avg_sentiment = sum(sentiment_scores) / len(sentiment_scores) if sentiment_scores else 0
    
    if avg_sentiment > 0.2:
        prediction = "Bullish"
    elif avg_sentiment < -0.2:
        prediction = "Bearish"
    else:
        prediction = "Neutral"
    
    return avg_sentiment, prediction

# Create Dash app
dash_app = dash.Dash(__name__)

dash_app.layout = html.Div([
    html.H1("Gold Price Prediction Dashboard"),
    html.H3("Live Gold Price: ", id='live-price'),
    dcc.Graph(id='price-chart'),
    dcc.Graph(id='sentiment-chart'),
    dcc.Graph(id='technical-chart')
])

@dash_app.callback(
    [Output('live-price', 'children'),
     Output('price-chart', 'figure'),
     Output('sentiment-chart', 'figure'),
     Output('technical-chart', 'figure')],
    Input('live-price', 'id')
)
def update_dashboard(_):
    gold_price = get_gold_price()
    historical_prices = get_historical_gold_prices()
    news_data = get_gold_news()
    avg_sentiment, prediction = analyze_trend(news_data)
    rsi, macd, macd_signal, sma = compute_technical_indicators(historical_prices)
    
    # Gold Price Chart
    price_fig = go.Figure()
    price_fig.add_trace(go.Scatter(y=[data['price'] for data in historical_prices],
                                   mode='lines', name='Gold Price'))
    
    # Sentiment Chart
    sentiment_fig = go.Figure()
    sentiment_fig.add_trace(go.Bar(y=[item[1] for item in news_data],
                                   name='Sentiment Score'))
    
    # Technical Analysis Chart
    tech_fig = go.Figure()
    tech_fig.add_trace(go.Scatter(y=rsi, mode='lines', name='RSI'))
    tech_fig.add_trace(go.Scatter(y=macd, mode='lines', name='MACD'))
    tech_fig.add_trace(go.Scatter(y=macd_signal, mode='lines', name='MACD Signal'))
    tech_fig.add_trace(go.Scatter(y=sma, mode='lines', name='50-Day SMA'))
    
    return f"Live Gold Price: ${gold_price}", price_fig, sentiment_fig, tech_fig

if __name__ == '__main__':
    dash_app.run_server(debug=True)
